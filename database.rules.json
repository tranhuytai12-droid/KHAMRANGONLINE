{
  "rules": {
    "players": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'f', 'x', 'z']) || !newData.exists()",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "f": {
          ".validate": "newData.val() >= 3 && newData.val() <= 6"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -16 && newData.val() <= 16"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -12 && newData.val() <= 12"
        },
        "r": {
          ".validate": "newData.isNumber()"
        },
        "s": {
          ".validate": "newData.isNumber()"
        },
        "h": {
          ".validate": "newData.isNumber()"
        },
        "fe": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "hp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "a": {
          ".validate": "newData.isNumber()"
        },
        "ak": {
          ".validate": "newData.isNumber()"
        },
        "b": {
          ".validate": "newData.isNumber()"
        },
        "ko": {
          ".validate": "newData.isNumber()"
        },
        "kb": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "w": {
          ".validate": "newData.isNumber()"
        },
        "sn": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
        },
        "dn": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feedback": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['s', 'c', 'u', 't'])",
        "s": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "f": {
          ".validate": "newData.val() === 3 || newData.val() === 4"
        },
        "u": {
          ".validate": "newData.val() === auth.uid"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
